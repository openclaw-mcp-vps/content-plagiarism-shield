NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional paywall cookie signing override
PAYWALL_COOKIE_SECRET=replace-with-a-long-random-string

# Optional NextAuth secret
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional SMTP for alerts + DMCA sends
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-mail-password
SMTP_FROM="Content Plagiarism Shield <alerts@example.com>"

# Optional runtime values
DASHBOARD_URL=http://localhost:3000/dashboard
DB_FILE_PATH=./data/storage.json
SCAN_CRON_SCHEDULE=0 */6 * * *
